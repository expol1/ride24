  "functions": [
    {
      "name": "consume_rate_limit",
      "definition": "CREATE OR REPLACE FUNCTION public.consume_rate_limit(p_scope text, p_key text, p_limit integer, p_window_seconds integer)\n RETURNS boolean\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\ndeclare v_hits integer;\r\nbegin\r\n  if auth.role() <> 'service_role' then raise exception 'SERVICE_ROLE_REQUIRED'; end if;\r\n  if p_limit < 1 or p_window_seconds < 1 then raise exception 'INVALID_RATE_LIMIT'; end if;\r\n\r\n  insert into public.api_request_limits(scope, rate_key, window_start, hits)\r\n  values(p_scope, p_key, now(), 1)\r\n  on conflict(scope, rate_key) do update\r\n    set hits = case\r\n      when public.api_request_limits.window_start < now() - make_interval(secs => p_window_seconds) then 1\r\n      else public.api_request_limits.hits + 1\r\n    end,\r\n    window_start = case\r\n      when public.api_request_limits.window_start < now() - make_interval(secs => p_window_seconds) then now()\r\n      else public.api_request_limits.window_start\r\n    end\r\n  returning hits into v_hits;\r\n\r\n  return v_hits <= p_limit;\r\nend;\r\n$function$\n"
    },
    {
      "name": "get_top_searches",
      "definition": "CREATE OR REPLACE FUNCTION public.get_top_searches()\n RETURNS TABLE(query text, count bigint)\n LANGUAGE sql\nAS $function$\r\n    select query, count(*) \r\n    from search_logs\r\n    where query is not null \r\n      and length(query) > 2\r\n    group by query\r\n    order by count desc\r\n    limit 5;\r\n$function$\n"
    },
    {
      "name": "is_admin",
      "definition": "CREATE OR REPLACE FUNCTION public.is_admin()\n RETURNS boolean\n LANGUAGE sql\n SECURITY DEFINER\nAS $function$\r\n  SELECT EXISTS (\r\n    SELECT 1\r\n    FROM public.profiles\r\n    WHERE id = auth.uid()\r\n    AND role = 'admin'\r\n  );\r\n$function$\n"
    }
  ],

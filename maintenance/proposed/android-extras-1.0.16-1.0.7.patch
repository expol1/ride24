@@ -0,0 +1,34 @@
+package pl.ride24.partner.data
+
+import org.json.JSONObject
+import org.junit.Assert.*
+import org.junit.Test
+
+class BookingBreakdownTest {
+    private fun fixture()=JSONObject(javaClass.classLoader!!.getResource("ride24-partner-items.json")!!.readText())
+    @Test fun readsAllServerNetItemsAndCashDepositSeparately() {
+        val b=BookingBreakdown.fromJson(fixture())
+        assertEquals(5,b.items.size);assertEquals(34000L,b.items.sumOf { it.amountCents });assertEquals(10000L,b.depositCents)
+        assertEquals(2,b.items.first { it.billing=="day" }.quantity);assertEquals(5,b.items.first { it.billing=="day" }.days)
+        assertEquals(2,b.items.count { it.location.isNotBlank() })
+    }
+    @Test fun historicalEmptyItemsAndUnknownDepositAreAccepted() {
+        val b=BookingBreakdown.fromJson(JSONObject("{\"items\":[],\"deposit_cents\":null}"))
+        assertTrue(b.items.isEmpty());assertNull(b.depositCents)
+    }
+    @Test fun zeroDepositIsNotUnknown() {
+        assertEquals(0L,BookingBreakdown.fromJson(JSONObject("{\"items\":[],\"deposit_cents\":0}")).depositCents)
+    }
+    @Test fun oldSidecarContractWithoutDepositRemainsCompatible() {
+        val row=fixture();row.remove("deposit_cents");assertNull(BookingBreakdown.fromJson(row).depositCents)
+    }
+    @Test fun missingItemsMustNotMasqueradeAsAFreeBooking() {
+        assertThrows(Exception::class.java){BookingBreakdown.fromJson(JSONObject())}
+    }
+    @Test fun negativePriceOrQuantityRejectsTheBreakdown() {
+        val row=fixture();row.getJSONArray("items").getJSONObject(0).put("amount_cents",-1)
+        assertThrows(IllegalArgumentException::class.java){BookingBreakdown.fromJson(row)}
+        val second=fixture();second.getJSONArray("items").getJSONObject(0).put("quantity",0)
+        assertThrows(IllegalArgumentException::class.java){BookingBreakdown.fromJson(second)}
+    }
+}

+package pl.ride24.partner.data
+
+import org.json.JSONObject
+
+/** The endpoint exposes partner amounts only; no platform margin enters this model. */
+data class BookingBreakdown(val items: List<BookingPriceItem>, val depositCents: Long?) {
+    companion object {
+        fun fromJson(row: JSONObject): BookingBreakdown {
+            val items = row.getJSONArray("items")
+            val deposit = if (row.has("deposit_cents") && !row.isNull("deposit_cents")) row.getLong("deposit_cents").also { require(it >= 0) } else null
+            return BookingBreakdown((0 until items.length()).map { index ->
+                val item = items.getJSONObject(index)
+                BookingPriceItem(item.getString("name_pl"), item.getString("name_en"), item.getInt("quantity").also { require(it in 1..10) },
+                    item.getInt("days").also { require(it in 1..366) }, item.getString("billing").also { require(it in listOf("day", "rental")) },
+                    item.optString("location_name", ""), item.getLong("amount_cents").also { require(it >= 0) })
+            }, deposit)
+        }
+    }
+}

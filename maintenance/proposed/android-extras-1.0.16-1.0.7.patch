+import org.json.JSONObject
+import org.junit.Assert.*
+import org.junit.Test
+
+class BookingContractTest {
+    private val offer = CarOffer("car", "partner")
+    private fun criteria(days: Long = 5) = SearchCriteria(
+        LocationItem(country = "Albania", city = "Tirana", locationName = "Airport (TIA)"),
+        LocationItem(country = "Albania", city = "Durrës", locationName = "City Office"),
+        LocalDate.of(2027, 1, 10), LocalDate.of(2027, 1, 10).plusDays(days))
+    private fun fixture(name: String = "ride24-quote.json") = JSONObject(javaClass.classLoader!!.getResource(name)!!.readText())
+    private fun selections() = listOf(ExtraSelection("60000000-0000-4000-8000-000000000001", 2), ExtraSelection("60000000-0000-4000-8000-000000000002", 1))
+
+    @Test fun sendsStoredPointNamesAndKeepsDecoratedNamesForDisplay() {
+        val c = criteria(); val body = bookingRequestContext(offer, c, null)
+        assertEquals("Airport (TIA)", body.getString("pickup_location"))
+        assertEquals("City Office", body.getString("return_location"))
+        assertTrue(c.pickup.displayName.contains("Albania"))
+        assertFalse(body.getString("pickup_location").contains("•"))
+    }
+    @Test fun cityOrCountrySuggestionCannotBeSubmittedAsABookablePoint() {
+        assertThrows(IllegalArgumentException::class.java) { bookingRequestContext(offer, criteria().copy(pickup = LocationItem(country = "Albania")), null) }
+    }
+    @Test fun readsServerCatalogueNamesBillingQuantityAndFullPriceWithoutRecalculating() {
+        val q = BookingQuote.fromJson(fixture()); val p = q.pricing!!
+        assertEquals(2, q.catalog.size); assertEquals(3, q.catalog.first { it.code == "child_seat" }.maxQuantity)
+        assertEquals("day", q.catalog.first { it.code == "child_seat" }.billing)
+        assertTrue(q.catalog.first().namePl.isNotBlank()); assertTrue(q.catalog.first().nameEn.isNotBlank())
+        assertEquals(41650L, p.totalCents); assertEquals(34000L, p.partnerCents); assertEquals(32895L, p.onlinePlnCents)
+        assertEquals(5, p.items.size); assertEquals(3750L, p.items.first { it.kind == "extra" && it.billing == "day" }.amountCents)
+    }
+    @Test fun sendsSameFingerprintAndSelectionsToBookingWithoutClientMoney() {
+        val q = BookingQuote.fromJson(fixture()); val body = q.acceptedPricingPayload(selections())
+        assertEquals(2, body.getInt("pricing_version")); assertEquals(q.fingerprint, body.getString("pricing_fingerprint"))
+        assertEquals(2, body.getJSONArray("extras").getJSONObject(0).getInt("quantity"))
+        assertFalse(body.has("total_cents")); assertFalse(body.has("partner_cents"))
+    }
+    @Test fun emergencyDisabledFeatureCannotDropSelectedExtras() {
+        assertThrows(IllegalStateException::class.java) { BookingQuote(false).acceptedPricingPayload(selections()) }
+        assertEquals(0, BookingQuote(false).acceptedPricingPayload(emptyList()).length())
+    }
+    @Test fun enabledQuoteMustHaveCompletePricingAndFingerprint() {
+        assertThrows(Exception::class.java) { BookingQuote.fromJson(JSONObject().put("enabled", true)) }
+        val q=BookingQuote.fromJson(fixture())
+        assertThrows(IllegalStateException::class.java) { q.copy(fingerprint="bad").acceptedPricingPayload(emptyList()) }
+    }
+    @Test fun changedDatesUseNewServerAmountsAndFingerprint() {
+        val original=BookingQuote.fromJson(fixture());val changed=BookingQuote.fromJson(fixture("ride24-quote-shorter.json"))
+        assertNotEquals(original.fingerprint, changed.fingerprint)
+        assertEquals(1500L, changed.pricing!!.items.first { it.kind=="extra" && it.billing=="day" }.amountCents)
+        assertEquals("2027-01-12", bookingRequestContext(offer,criteria(2),null).getString("end_date"))
+    }
+    @Test fun additionalDriverIsIncludedInBothRequestContexts() {
+        assertEquals("driver", bookingRequestContext(offer,criteria(),"driver").getString("additional_driver_id"))
+        assertFalse(bookingRequestContext(offer,criteria(),null).has("additional_driver_id"))
+    }
+    @Test fun driverProductTracksDriverSelectionAndDoesNotDuplicateOrRemoveOtherExtras() {
+        val driver=BookingExtra("driver-extra","additional_driver","Kierowca","Driver","rental",1,1250)
+        val selected=selections().withAdditionalDriver(listOf(driver),"driver-id")
+        assertEquals(1,selected.count { it.id==driver.id });assertEquals(3,selected.size)
+        assertEquals(selected,selected.withAdditionalDriver(listOf(driver),"driver-id"))
+        assertEquals(selections(),selected.withAdditionalDriver(listOf(driver),null))
+        assertEquals(selections(),selections().withAdditionalDriver(emptyList(),"free-driver"))
+    }
+    @Test fun legacyBookingsWithoutSnapshotStillReadTheirSavedAmounts() {
+        val booking=Booking.fromJson(JSONObject().put("id","old").put("status","paid").put("final_price_snapshot",123.45)
+            .put("online_payment_pln",50).put("pickup_payment_partner_currency",110).put("deposit_snapshot",100))
+        assertNull(booking.pricing);assertEquals(123.45,booking.finalPriceSnapshot,0.0);assertEquals(100.0,booking.depositSnapshot!!,0.0)
+    }
+    @Test fun actualHttpClientSendsCanonicalContextAndBearerThenParsesTheServerQuote() = runBlocking {
+        MockWebServer().use { server ->
+            server.enqueue(MockResponse().setHeader("Content-Type","application/json").setBody(fixture().toString()))
+            server.start()
+            val api=Ride24Api(server.url("/").toString().trimEnd('/'),"test-public-key")
+            api.sessionProvider={Session("test-jwt","test-refresh","user","test@example.invalid",Long.MAX_VALUE)}
+            val q=BookingQuote.fromJson(api.function("booking-options",bookingRequestContext(offer,criteria(),null).put("extras",selections().toJsonArray()),true))
+            val request=server.takeRequest(5,TimeUnit.SECONDS)!!
+            assertEquals("/functions/v1/booking-options",request.path);assertEquals("Bearer test-jwt",request.getHeader("Authorization"))
+            assertEquals("Airport (TIA)",JSONObject(request.body.readUtf8()).getString("pickup_location"));assertEquals(41650L,q.pricing!!.totalCents)
+        }
+    }
+    @Test fun actualHttpConflictIsNotTreatedAsSuccessfulOrCheaperQuote() = runBlocking {
+        MockWebServer().use { server ->
+            server.enqueue(MockResponse().setResponseCode(409).setBody("{\"code\":\"QUOTE_CHANGED\",\"error\":\"Price changed\"}"));server.start()
+            val api=Ride24Api(server.url("/").toString().trimEnd('/'),"test-public-key")
+            api.sessionProvider={Session("test-jwt","test-refresh","user","test@example.invalid",Long.MAX_VALUE)}
+            try { api.function("create-booking-request",JSONObject(),true);fail("409 must throw") }
+            catch(e:ApiException){assertEquals(409,e.status);assertEquals("QUOTE_CHANGED",e.code)}
+        }
+    }
+}

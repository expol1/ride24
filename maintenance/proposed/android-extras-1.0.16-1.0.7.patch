+package pl.ride24.client.data
+
+import org.json.JSONObject
+
+/** Both endpoints must receive the stored point name, never the decorated search label. */
+fun bookingRequestContext(offer: CarOffer, criteria: SearchCriteria, additionalDriverId: String?): JSONObject {
+    require(criteria.pickup.locationName.isNotBlank() && criteria.dropoff.locationName.isNotBlank()) {
+        "BOOKING_LOCATION_REQUIRED"
+    }
+    return JSONObject().put("car_class_id", offer.id)
+        .put("start_date", criteria.pickupDate.toString()).put("end_date", criteria.returnDate.toString())
+        .put("pickup_time", criteria.pickupTime).put("return_time", criteria.returnTime)
+        .put("pickup_location", criteria.pickup.locationName).put("return_location", criteria.dropoff.locationName)
+        .also { body -> additionalDriverId?.let { body.put("additional_driver_id", it) } }
+}
+
+/** A disabled feature must never silently discard a previously selected paid item. */
+fun BookingQuote.acceptedPricingPayload(extras: List<ExtraSelection>): JSONObject {
+    check(enabled || extras.isEmpty()) { "PRICING_UPDATE_REQUIRED" }
+    return JSONObject().also { body ->
+        if (enabled) {
+            check(pricing != null && fingerprint.matches(Regex("[a-f0-9]{64}"))) { "INVALID_QUOTE" }
+            body.put("pricing_version", 2).put("pricing_fingerprint", fingerprint).put("extras", extras.toJsonArray())
+        }
+    }
+}
+
+fun List<ExtraSelection>.withAdditionalDriver(catalog: List<BookingExtra>, driverId: String?): List<ExtraSelection> {
+    val driver = catalog.firstOrNull { it.code == "additional_driver" } ?: return this
+    return filterNot { it.id == driver.id } + if (driverId == null) emptyList() else listOf(ExtraSelection(driver.id, 1))
+}

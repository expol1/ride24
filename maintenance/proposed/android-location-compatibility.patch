+    // Resolve all owners before applying the car result limit. Shared locations
+    // are identified by name + country + city, never by one partner's row ID.
+    private suspend fun locationPartners(location: LocationItem): Set<String> {
+        val params = linkedMapOf("select" to "id,partner_id", "active" to "eq.true", "order" to "id.asc", "limit" to "500")
+        if (location.locationName.isNotBlank()) params["location_name"] = "eq.${location.locationName}"
+        if (location.country.isNotBlank()) params["country"] = "eq.${location.country}"
+        if (location.city.isNotBlank()) params["city"] = "eq.${location.city}"
+        if (location.locationName.isBlank() && location.city.isBlank() && location.region.isNotBlank()) params["region"] = "eq.${location.region}"
+        val owners = linkedSetOf<String>()
+        var offset = 0
+        while (true) {
+            params["offset"] = offset.toString()
+            val rows = api.rest("partner_locations", params, auth = false).asArray()
+            for (i in 0 until rows.length()) {
+                val id = rows.getJSONObject(i).optString("partner_id")
+                if (id.matches(Regex("[0-9a-fA-F-]{36}"))) owners += id
+            }
+            if (rows.length() < 500) break
+            offset += rows.length()
+        }
+        return owners
+    }

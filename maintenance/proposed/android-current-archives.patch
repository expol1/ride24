+package pl.ride24.client.data
+
+import org.json.JSONArray
+import org.json.JSONObject
+
+data class ExtraSelection(val id: String, val quantity: Int)
+data class BookingExtra(val id: String, val code: String, val namePl: String, val nameEn: String, val billing: String, val maxQuantity: Int, val unitCents: Long)
+data class BookingPriceItem(val kind: String, val namePl: String, val nameEn: String, val quantity: Int, val days: Int, val billing: String, val location: String, val amountCents: Long)
+data class BookingPricing(val currency: String, val items: List<BookingPriceItem>, val totalCents: Long, val discountCents: Long, val onlinePlnCents: Long, val partnerCents: Long) {
+    companion object {
+        fun fromJson(json: JSONObject?): BookingPricing? {
+            if (json == null || json.optInt("version") != 2) return null
+            val rows = json.getJSONArray("items")
+            return BookingPricing(json.getString("currency"), (0 until rows.length()).map { i ->
+                val r = rows.getJSONObject(i)
+                BookingPriceItem(r.getString("kind"), r.getString("name_pl"), r.getString("name_en"), r.getInt("quantity"), r.getInt("days"), r.getString("billing"), r.optString("location_name", ""), r.getLong("customer_cents"))
+            }, json.getLong("total_cents"), json.getLong("loyalty_discount_cents"), json.getLong("online_pln_cents"), if (json.has("pickup_payment_cents")) json.getLong("pickup_payment_cents") else json.getLong("partner_cents"))
+        }
+    }
+}
+data class BookingQuote(val enabled: Boolean, val fingerprint: String = "", val pricing: BookingPricing? = null, val catalog: List<BookingExtra> = emptyList()) {
+    companion object {
+        fun fromJson(json: JSONObject): BookingQuote {
+            if (!json.getBoolean("enabled")) return BookingQuote(false)
+            val rows = json.getJSONArray("catalog")
+            return BookingQuote(true, json.getString("fingerprint"), requireNotNull(BookingPricing.fromJson(json.getJSONObject("pricing"))), (0 until rows.length()).map { i ->
+                val r = rows.getJSONObject(i)
+                BookingExtra(r.getString("id"), r.getString("code"), r.getString("name_pl"), r.getString("name_en"), r.getString("billing"), r.getInt("max_quantity"), r.getLong("unit_customer_cents"))
+            })
+        }
+    }
+}
+fun List<ExtraSelection>.toJsonArray(): JSONArray = JSONArray().also { array -> forEach { array.put(JSONObject().put("id", it.id).put("quantity", it.quantity)) } }
